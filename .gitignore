# Build output
bin/
obj/
artifacts/

# Local tooling
.vs/
*.user

# Downloaded ONNX weights and any other large local assets
models/
*.onnx

# Throwaway index homes and probe scripts used while evaluating enrichment and
# synthesis changes. These hold generated indexes and cached HTTP responses.
.exp-*/
.llm-probe.json
.shot/
*.py

# A generated index is a list of what is installed on the machine that built it,
# so it is local data rather than source and must never be committed.
.verify/
*.sqlite
vectors.bin

.commitmsg

.scratch/
