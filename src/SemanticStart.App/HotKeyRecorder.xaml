<UserControl x:Class="SemanticStart.App.HotKeyRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Cursor="Hand" MinWidth="190">
    <UserControl.Resources>
        <!-- One key, drawn as a Windows 11 keycap. -->
        <DataTemplate x:Key="KeyChipTemplate">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4"
                    Padding="9,4" Margin="3,0,0,0" MinWidth="30">
                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="13"
                           FontFamily="{DynamicResource UiFont}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Surface" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource SearchBoxBrush}"
            BorderBrush="{DynamicResource SearchBoxBorderBrush}"
            Padding="6,5">
        <Grid>
            <ItemsControl x:Name="Chips" HorizontalAlignment="Right" VerticalAlignment="Center"
                          ItemTemplate="{StaticResource KeyChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="Prompt" Visibility="Collapsed"
                       Text="Press a key combination" FontSize="13"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2" />
        </Grid>
    </Border>
</UserControl>
