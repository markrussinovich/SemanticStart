<Window x:Class="SemanticStart.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SemanticStart Settings" Width="620" Height="760" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <!-- Windows 11 settings "card": a rounded surface holding one setting. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="SemanticStart" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Activation" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Hotkey" />
                            <TextBlock x:Name="HotKeyStatus" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="HotKeyBox" Grid.Column="1" Width="190" VerticalAlignment="Center"
                                  Style="{StaticResource FluentComboBox}"
                                  SelectedValuePath="Content" FontSize="14">
                            <ComboBoxItem Content="Win+Alt+Space" />
                            <ComboBoxItem Content="Win+Alt+S" />
                            <ComboBoxItem Content="Win+Alt+X" />
                            <ComboBoxItem Content="Win+Ctrl+G" />
                            <ComboBoxItem Content="Win+Shift+S" />
                            <ComboBoxItem Content="Ctrl+Alt+Space" />
                            <ComboBoxItem Content="Ctrl+Alt+S" />
                            <ComboBoxItem Content="Ctrl+Shift+Space" />
                            <ComboBoxItem Content="Alt+Shift+Space" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="TakeStartBox" Content="Take over the Start key (solo Windows key press)" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Off by default. This uses a low-level keyboard hook, which cannot see input while an elevated window has focus, so the real Start menu opens normally there. Reserved combinations such as Win+L are never intercepted." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Indexing" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="OnlineBox" Content="Allow online enrichment while indexing" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Fetches public documentation to improve descriptions. Searches always stay on this device; only indexing touches the network, and results are cached." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Local LLM synthesis" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Generate richer app descriptions with a small local model" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Auto probes local Foundry, Ollama, LM Studio, and OpenAI-compatible servers. Pick a ready model, or select a curated small model and download it." />
                        <TextBlock x:Name="LocalLlmRuntimeStatusText" Style="{StaticResource Caption}" Text="Checking local runtimes..." />
                        <TextBlock x:Name="LastGeneratorStatusText" Style="{StaticResource Caption}" Text="Last index generator: checking..." />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Expect roughly 8–15 minutes to synthesize ~470 entities with a 1–2B CPU model; larger models can take much longer. Each entity has a timeout and falls back safely." />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center" />
                            <ComboBox x:Name="LocalLlmModeBox" Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      Style="{StaticResource FluentComboBox}" SelectedValuePath="Content" FontSize="14">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <TextBox x:Name="LocalLlmEndpointBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                     ToolTip="Example: http://localhost:11434 for Ollama or http://localhost:1234 for LM Studio" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LocalLlmModelBox" Grid.Column="0" MinWidth="300"
                                          Style="{StaticResource FluentComboBox}" DisplayMemberPath="PickerLabel" FontSize="14"
                                          SelectionChanged="LocalLlmModelBox_SelectionChanged" />
                                <Button x:Name="RefreshModelsButton" Grid.Column="1" Content="Refresh" Style="{StaticResource FluentButton}"
                                        Margin="8,0,0,0" Click="RefreshModelsButton_Click" />
                            </Grid>

                            <CheckBox x:Name="CustomModelBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                                      Content="Advanced: use a custom model identifier"
                                      Checked="CustomModelBox_Changed" Unchecked="CustomModelBox_Changed" />

                            <TextBox x:Name="LocalLlmCustomModelBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"
                                     Visibility="Collapsed"
                                     ToolTip="Example: qwen2.5:1.5b, llama3.2:1b, phi-3.5-mini" />

                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TestLocalLlmButton" Content="Test connection" Style="{StaticResource FluentButton}"
                                        Click="TestLocalLlmButton_Click" />
                                <Button x:Name="DownloadModelButton" Grid.Column="1" Content="Download model" Style="{StaticResource FluentButton}"
                                        Margin="8,0,0,0" Click="DownloadModelButton_Click" />
                                <Button x:Name="InstallFoundryButton" Grid.Column="2" Content="Install Foundry Local" Style="{StaticResource AccentButton}"
                                        Margin="8,0,0,0" Click="InstallFoundryButton_Click" />
                                <TextBlock x:Name="LocalLlmStatusText" Grid.Column="3" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ProgressBar x:Name="LocalLlmProgressBar" Grid.Row="6" Grid.Column="1" Height="4" Minimum="0" Maximum="1"
                                         Margin="0,10,0,0" Background="{DynamicResource ItemHoverBrush}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Results shown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="LimitSlider" Width="180" Minimum="3" Maximum="20" IsSnapToTickEnabled="True"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElementName=LimitSlider, Path=Value, StringFormat=F0}" Width="26"
                                           TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Index" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Text="Ready" />
                        <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="1" Margin="0,10,0,10"
                                     Background="{DynamicResource ItemHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0" />
                        <Button x:Name="RebuildButton" Content="Rebuild index" Style="{StaticResource FluentButton}"
                                HorizontalAlignment="Left" Click="RebuildButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="LoginBox" Content="Start SemanticStart when I sign in" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="100" Margin="0,0,8,0" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
                <Button Content="Close" Width="100" Style="{StaticResource FluentButton}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
