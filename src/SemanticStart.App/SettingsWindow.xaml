<Window x:Class="SemanticStart.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SemanticStart.App"
        Title="SemanticStart Settings" Width="620" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        Icon="/SemanticStart.App;component/Assets/SemanticStart.ico"
        ResizeMode="CanMinimize" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <!-- Windows 11 settings "card": a rounded surface holding one setting. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontSmall}" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                <!--
                                    Windows marks a text field with a stroke along its bottom edge -
                                    stronger than the surrounding border at rest, and an accent line
                                    twice as thick once focused - rather than recolouring the whole
                                    outline.
                                -->
                                <Border x:Name="BottomLine" Height="1" VerticalAlignment="Bottom"
                                        CornerRadius="0,0,6,6" Background="{DynamicResource ControlStrongStrokeBrush}" />
                                <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom"
                                        CornerRadius="0,0,6,6" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputActiveBrush}" />
                                <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Subtitle sizes use Segoe UI Variable Display, the face Windows switches to at 18px. -->
            <TextBlock Text="SemanticStart" FontFamily="{DynamicResource UiFontDisplay}"
                       FontSize="{DynamicResource SubtitleFontSize}" FontWeight="SemiBold" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Activation" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Hotkey" />
                            <TextBlock x:Name="HotKeyStatus" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <local:HotKeyRecorder x:Name="HotKeyBox" Grid.Column="1" VerticalAlignment="Center"
                                              HotKeyChanged="HotKeyBox_HotKeyChanged"
                                              HotKeyRejected="HotKeyBox_HotKeyRejected"
                                              RecordingStarted="HotKeyBox_RecordingStarted"
                                              RecordingStopped="HotKeyBox_RecordingStopped" />
                    </Grid>
                </Border>

                <TextBlock Text="Indexing" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="OnlineBox" Content="Allow online enrichment while indexing" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Fetches public documentation to improve descriptions. Searches always stay on this device; only indexing touches the network, and results are cached." />
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Results shown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="LimitSlider" Width="180" Minimum="3" Maximum="20" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElementName=LimitSlider, Path=Value, StringFormat=F0}" Width="26"
                                           TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Wait for typing to stop" />
                                <TextBlock Text="Searches only once the query settles, so results stop rebuilding letter by letter. Enter searches immediately."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="DebounceSlider" Width="180" Minimum="0" Maximum="1000" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"
                                        TickFrequency="50" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElementName=DebounceSlider, Path=Value, StringFormat={}{0:F0} ms}" Width="58"
                                           TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Status sits beside the header rather than under the numbers: it describes
                             the index as a whole, and below the list it read like one more statistic. -->
                        <Grid>
                            <TextBlock Text="Index" />
                            <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Text="Ready"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="IndexStatsText" Style="{StaticResource Caption}" Text="Reading index..."
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                        <!-- Counts live in their own right-aligned column so digits line up and can
                             be compared down the list rather than read one line at a time. -->
                        <Grid x:Name="IndexStatsGrid" Visibility="Collapsed" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="BackgroundNote" Style="{StaticResource Caption}" Visibility="Collapsed"
                                   Text="You can close this window; indexing runs in the background." />
                        <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="1" Margin="0,10,0,10"
                                     Background="{DynamicResource ItemHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0" />
                        <Button x:Name="RebuildButton" Content="Rebuild index" Style="{StaticResource FluentButton}"
                                HorizontalAlignment="Left" Click="RebuildButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="LoginBox" Content="Start SemanticStart when I sign in" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontFamily="{DynamicResource UiFontSmall}" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,8,0" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
                <Button Content="Close" Width="100" Style="{StaticResource FluentButton}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
