<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
        <!--
            Light-theme defaults, taken from the Windows 11 (WinUI) common colour set so the app
            reads as system UI rather than an approximation of it. The comment after each key names
            the Windows resource it mirrors. ThemeService overwrites every one of these at startup
            and again whenever the system switches between light and dark, so anything that should
            follow the system must bind with DynamicResource.
        -->
        <SolidColorBrush x:Key="PanelBrush" Color="#F9F9F9" />                   <!-- AcrylicBackgroundFillColorDefaultFallback -->
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#0F000000" />           <!-- SurfaceStrokeColorFlyout -->
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#E4000000" />            <!-- TextFillColorPrimary -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4000000" />           <!-- TextFillColorPrimary -->
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E000000" />         <!-- TextFillColorSecondary -->
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#72000000" />          <!-- TextFillColorTertiary -->
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C000000" />          <!-- TextFillColorDisabled -->
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />            <!-- TextOnAccentFillColorPrimary -->
        <SolidColorBrush x:Key="SearchBoxBrush" Color="#B3FFFFFF" />             <!-- ControlFillColorDefault -->
        <SolidColorBrush x:Key="InputActiveBrush" Color="#FFFFFF" />             <!-- ControlFillColorInputActive -->
        <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#0F000000" />       <!-- ControlStrokeColorDefault -->
        <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#72000000" />   <!-- ControlStrongStrokeColorDefault -->
        <SolidColorBrush x:Key="FocusStrokeBrush" Color="#E4000000" />           <!-- FocusStrokeColorOuter -->
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#09000000" />             <!-- SubtleFillColorSecondary -->
        <SolidColorBrush x:Key="ItemSelectedBrush" Color="#0F000000" />          <!-- ListViewItemBackgroundSelected -->
        <SolidColorBrush x:Key="IconBackplateBrush" Color="#06000000" />         <!-- ControlAltFillColorSecondary -->
        <SolidColorBrush x:Key="BadgeBrush" Color="#0A000000" />                 <!-- ControlAltFillColorTertiary -->
        <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />               <!-- DividerStrokeColorDefault -->
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#72000000" />        <!-- ControlStrongFillColorDefault -->
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#9E000000" />   <!-- ScrollBarPanningThumbBackground -->
        <SolidColorBrush x:Key="ScrollBarButtonHoverBrush" Color="#09000000" />  <!-- SubtleFillColorSecondary -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />                  <!-- AccentFillColorDefault (SystemAccentColorDark1) -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E60067C0" />           <!-- AccentFillColorSecondary -->
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC0067C0" />         <!-- AccentFillColorTertiary -->
        <SolidColorBrush x:Key="AccentTextBrush" Color="#003E92" />              <!-- AccentTextFillColorPrimary -->
        <Color x:Key="ShadowColor">#000000</Color>
        <sys:Double x:Key="ShadowOpacity">0.28</sys:Double>

        <!--
            Windows 11 type ramp. Segoe UI Variable ships three optical sizes and the system picks
            between them by point size rather than using one face everywhere: Small below 14px,
            Text for body copy, Display from 18px up. Matching that split is most of what makes
            text look like it belongs to the shell.
        -->
        <FontFamily x:Key="UiFontSmall">Segoe UI Variable Small, Segoe UI</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <sys:Double x:Key="CaptionFontSize">12</sys:Double>
        <sys:Double x:Key="BodyFontSize">14</sys:Double>
        <sys:Double x:Key="BodyLargeFontSize">18</sys:Double>
        <sys:Double x:Key="SubtitleFontSize">20</sys:Double>

        <!-- Windows 11 subtle button: transparent until hovered. -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Fluent push button, used by the settings window. -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Accent button. Windows dims the accent fill on hover and press instead of tinting it,
            and the label follows TextOnAccentFillColorPrimary, which is black in dark mode because
            the accent lightens there.
        -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            WPF's stock ComboBox chrome is hard-coded light, so it stays white in dark mode. This
            template re-skins it from the theme brushes instead.
        -->
        <Style x:Key="FluentComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FluentComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource SearchBoxBrush}"
                                                BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" />
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontSize="10" Margin="8,0,11,0"
                                                           FontFamily="{DynamicResource IconFont}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Selected" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="0,4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                          Color="{DynamicResource ShadowColor}" Opacity="0.3" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Windows 11 overlay scrollbar: thin at rest, full-width with line buttons on hover. -->
        <Style x:Key="WindowsVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>

                            <RepeatButton x:Name="LineUp" Grid.Row="0" Command="ScrollBar.LineUpCommand"
                                          Focusable="False" Opacity="0">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                            <Path Data="M 0,4 L 4,0 L 8,4 Z" Width="8" Height="4"
                                                  Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ScrollBarButtonHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinHeight="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="ThumbBar" Width="2"
                                                            Background="{DynamicResource ScrollBarThumbBrush}"
                                                            CornerRadius="3" HorizontalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Width" Value="6" />
                                                        <Setter TargetName="ThumbBar" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Width" Value="6" />
                                                        <Setter TargetName="ThumbBar" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                                                 Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Width" Value="6" />
                                                        <Setter TargetName="ThumbBar" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                                                 Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Width" Value="6" />
                                                        <Setter TargetName="ThumbBar" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                  Opacity="0" Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                  Opacity="0" Background="Transparent" />
                                </Track.DecreaseRepeatButton>
                            </Track>

                            <RepeatButton x:Name="LineDown" Grid.Row="2" Command="ScrollBar.LineDownCommand"
                                          Focusable="False" Opacity="0">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                            <Path Data="M 0,0 L 4,4 L 8,0 Z" Width="8" Height="4"
                                                  Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ScrollBarButtonHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LineUp" Property="Opacity" Value="1" />
                                <Setter TargetName="LineDown" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="LineUp" Property="Opacity" Value="1" />
                                <Setter TargetName="LineDown" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <!--
                                Callers keep the bar permanently visible so it always occupies layout
                                space and list rows never shift width as results come and go. Maximum
                                is the scrollable extent, so zero means everything fits: hide the bar
                                but keep the gap it reserved.
                            -->
                            <Trigger Property="Maximum" Value="0">
                                <Setter TargetName="Root" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
