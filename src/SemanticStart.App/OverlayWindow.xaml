<Window x:Class="SemanticStart.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SemanticStart.App"
        Width="720" Height="600" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="IconVisible" />
        <local:NullToVisibilityConverter x:Key="IconMissing" Invert="True" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <DropShadowEffect x:Key="ResultCardShadow" BlurRadius="8" ShadowDepth="2" Direction="270"
                          Color="{DynamicResource ShadowColor}" Opacity="0.16" />

        <!--
            Chevron that reveals a result's full description. Templated rather than a default
            ToggleButton so it reads as a quiet affordance next to the kind badge instead of a
            raised button, and rotates to point down when open.
        -->
        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="Glyph" Text="&#xE70D;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleButtonPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The pill keeps a full focus outline rather than an input underline. -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                                           FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SearchGlyphBrush}" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="Placeholder" Text="Search apps, settings, and Windows features"
                                               Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"
                                               IsHitTestVisible="False" />
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" Padding="12,18,12,12" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                              Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="4,0,4,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SemanticStart" FontFamily="{DynamicResource UiFontDisplay}"
                               FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchTextBox}"
                     TextChanged="SearchBox_TextChanged"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Text="Apps, settings, and features" Margin="4,22,0,8"
                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" />

            <ListBox x:Name="ResultsList" Grid.Row="3" Margin="0,0,0,4" ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     local:SmoothScroll.Enabled="True"
                     Foreground="{DynamicResource PrimaryTextBrush}">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource WindowsVerticalScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,2,4,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Rule" BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1" Margin="6,0" />
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                                Padding="10,9" MinHeight="68" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                            <Setter TargetName="Rule" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource ResultCardShadow}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                                            <Setter TargetName="Rule" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource ResultCardShadow}" />
                                        </Trigger>
                                        <!-- Keep keyboard navigation distinct from the soft selected card. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding DataContext.IsResultsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SearchResultItem}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid MouseLeftButtonUp="Result_MouseLeftButtonUp" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource IconBackplateBrush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" />
                                    <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Icon, Converter={StaticResource IconVisible}}" />
                                    <TextBlock Text="{Binding FallbackGlyph}" FontFamily="{DynamicResource IconFont}"
                                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding Icon, Converter={StaticResource IconMissing}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontFamily="{DynamicResource UiFontSmall}"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource SearchBoxBrush}" CornerRadius="12" Padding="9,3"
                                        BorderBrush="{DynamicResource SearchBoxBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding KindBadge}" FontFamily="{DynamicResource UiFontSmall}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource SubtleButton}"
                                        Width="26" Height="26" FontSize="13" Focusable="False"
                                        Content="{Binding CopyGlyph}" ToolTip="{Binding CopyToolTip}"
                                        ToolTipService.ShowDuration="20000"
                                        AutomationProperties.Name="Copy command line"
                                        Visibility="{Binding HasCommandLine, Converter={StaticResource BoolToVisible}}"
                                        Click="CopyCommandLine_Click"
                                        VerticalAlignment="Center" Margin="6,0,0,0" />
                                <ToggleButton Grid.Column="4" x:Name="DetailsToggle" Style="{StaticResource ChevronToggle}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              ToolTip="Show details (Ctrl+D)"
                                              AutomationProperties.Name="Show details"
                                              VerticalAlignment="Center" Margin="4,0,2,0" />
                            </Grid>

                            <Border Grid.Row="1" Margin="60,6,8,6" Padding="10,8" CornerRadius="6"
                                    Background="{DynamicResource BadgeBrush}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailSummary}" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource UiFontSmall}" FontSize="{DynamicResource CaptionFontSize}"
                                               Visibility="{Binding HasDetailSummary, Converter={StaticResource BoolToVisible}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisible}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource UiFontSmall}"
                                                           FontSize="{DynamicResource CaptionFontSize}"
                                                           TextWrapping="Wrap" Margin="0,1"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Provenance}" FontFamily="{DynamicResource UiFontSmall}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasProvenance, Converter={StaticResource BoolToVisible}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding LaunchTarget}" FontFamily="{DynamicResource UiFontSmall}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasLaunchTarget, Converter={StaticResource BoolToVisible}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer: settings on the left, status to its right. -->
            <Grid Grid.Row="4" Margin="2,6,0,0">
                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource DividerBrush}" Margin="0,-6,0,0" />
                <Button x:Name="SettingsButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                        Width="32" Height="32" FontSize="15" Content="&#xE713;" ToolTip="Settings"
                        Click="SettingsButton_Click" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="{DynamicResource UiFontSmall}" FontSize="{DynamicResource CaptionFontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="40,0,4,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
