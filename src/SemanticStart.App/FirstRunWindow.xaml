<Window x:Class="SemanticStart.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up SemanticStart" Width="600" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Set up SemanticStart" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource HeaderTextBrush}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="SemanticStart builds a searchable index of your apps, settings, and built-in Windows tools so you can find them by describing what you want. These choices affect how good that index is, so they are asked before it is built." />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="HotKeyText" Text="Open with Win+Alt+Space" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Your Start menu is not modified. You can change this hotkey later in Settings." />
                    <CheckBox x:Name="LaunchAtLoginCheck" Content="Start SemanticStart when I sign in" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="OnlineCheck" Content="Look up documentation online while indexing" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Most installed programs describe themselves with nothing but their own name, so without this many tools can only be found if you already know what they are called. Only app and feature names are sent, only while indexing. What you type when searching is never sent anywhere." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Describe apps with a local AI model" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Documentation found online is written for readers, not searchers, and is sometimes about the wrong thing entirely. A small model running on this PC turns it into a plain description and the phrases you would actually type. It runs only while indexing, and nothing leaves your machine." />

                    <RadioButton x:Name="LlmAutoRadio" Content="Use a local model (recommended)" Margin="0,10,0,0"
                                 Checked="LlmMode_Changed" />
                    <RadioButton x:Name="LlmOffRadio" Content="Don't use a model" Checked="LlmMode_Changed" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelCombo" Grid.Column="0" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="ModelActionButton" Grid.Column="1" Content="Download" Margin="8,0,0,0"
                                Style="{StaticResource FluentButton}" VerticalAlignment="Center"
                                Click="ModelActionButton_Click" />
                    </Grid>
                    <ProgressBar x:Name="ModelProgress" Height="4" Minimum="0" Maximum="1" Margin="0,8,0,0"
                                 Background="{DynamicResource ItemHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0" Visibility="Collapsed" />
                    <TextBlock x:Name="LlmStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" MaxHeight="60" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="EstimateText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" MaxWidth="330" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip for now" Style="{StaticResource FluentButton}"
                        Margin="0,0,8,0" Click="SkipButton_Click" />
                <Button x:Name="BuildButton" Content="Build index" Style="{StaticResource AccentButton}"
                        Click="BuildButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
